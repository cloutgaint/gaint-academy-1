APP_ENV=development
APP_NAME=GAINT Academy
API_PORT=8000
WEB_PORT=3000
POSTGRES_DB=gaint_academy
POSTGRES_USER=gaint
POSTGRES_PASSWORD=change-me-local
POSTGRES_HOST_PORT=5432
DATABASE_URL=postgresql+psycopg://gaint:change-me-local@postgres:5432/gaint_academy
REDIS_URL=redis://redis:6379/0
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=gaint-local
MINIO_SECRET_KEY=change-me-local
MINIO_BUCKET=gaint-academy
SEED_ADMIN_EMAIL=gaintclout@gmail.com
SEED_ADMIN_PASSWORD=change-me-through-env
SESSION_HOURS=8
COOKIE_SECURE=false

# SMTP password-reset delivery. Configure these locally/staging/production; never commit real credentials.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
PASSWORD_RESET_OTP_MINUTES=10

PAYMENT_WEBHOOK_SECRET=
